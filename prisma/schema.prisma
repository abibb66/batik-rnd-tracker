// Prisma schema — Dashboard Tracker RnD Produk Batik
// Alur: RnD -> (PPIC & Warehouse paralel) -> Marketing

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Divisi {
  RND
  PPIC
  WAREHOUSE
  MARKETING
  ADMIN
  VISITOR
}

// Daftar awal vendor, disimpan sebagai String bebas di Produk.vendor
// (bisa ditambah tanpa migrasi): Trading 1500, Trading DigiPrint, Harjono 1.5,
// Harjono 115, Bima Kunting, Mbak Dwi, Mas Della, Rudy

// Kategori & status (RnD/PPIC/Warehouse/Marketing) dulunya enum di sini,
// sekarang jadi baris DropdownOption yang bisa diedit lewat /admin/opsi.
// Produk.kategori/statusX menyimpan DropdownOption.nilai sebagai String biasa.
// Baris tunggal (id selalu "singleton") untuk pengaturan tampilan global:
// nama situs & logo, bisa diedit lewat /admin/pengaturan tanpa perlu update kode.
model SiteSettings {
  id        String   @id @default("singleton")
  namaSitus String   @default("Batik RnD Tracker")
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Vendor dulunya cuma daftar String bebas (VENDOR_LIST), sekarang jadi baris
// biar tiap vendor punya lead time sendiri (dipakai buat auto-hitung Estimasi
// Ready Stok & Plan Launching begitu status RnD jadi PO Kain). Produk.vendor
// tetap String bebas (dicocokkan ke Vendor.nama), bukan foreign key, biar
// vendor lama yang belum terdaftar di sini tidak error.
model Vendor {
  id           String   @id @default(cuid())
  nama         String   @unique
  leadTimeHari Int      @default(14)
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vendor")
}

model DropdownOption {
  id        String   @id @default(cuid())
  grup      String
  nilai     String
  label     String
  urutan    Int
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([grup, nilai])
  @@map("dropdown_option")
}

model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String
  divisi       Divisi
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riwayatStatus RiwayatStatus[]

  @@map("users")
}

model Produk {
  id               String   @id @default(cuid())
  kodeProduk       String   @unique
  driveFolderLink  String?
  driveFolderId    String?

  // --- RnD ---
  kategori              String?
  vendor                String?
  uspWarna              String?
  tanggalMulai          DateTime?
  planLaunching         DateTime?
  desainLink            String?
  polaKemejaLink        String?
  statusRnd             String   @default("ACC_DESAIN")
  strikeOffDicetak      Boolean  @default(false)
  estimasiStrikeOffJadi DateTime?

  // --- PPIC ---
  statusPpic          String @default("BELUM_MULAI")
  tanggalMasukVendor  DateTime?
  estimasiJadi        DateTime?
  kendalaPpic         String?

  // --- Warehouse ---
  statusWarehouse  String @default("BELUM_MULAI")
  sku              String?
  kendalaWarehouse String?
  stokUkuran       StokUkuran[]

  // --- Marketing ---
  statusMarketing  String @default("BELUM_MULAI")
  namaMotif        String?
  filosofiMotif    String?
  linkMarketplace  String?
  kendalaMarketing String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riwayatStatus RiwayatStatus[]

  @@map("produk")
}

// Stok Warehouse dulunya satu angka (Produk.stok), sekarang dipecah per ukuran
// supaya Warehouse bisa catat S/M/L/XL/XXL terpisah, dan bisa tambah ukuran
// custom lain (mis. "All Size", "3XL") tanpa perlu migrasi baru.
model StokUkuran {
  id        String   @id @default(cuid())
  produkId  String
  produk    Produk   @relation(fields: [produkId], references: [id], onDelete: Cascade)
  ukuran    String
  jumlah    Int      @default(0)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produkId, ukuran])
  @@map("stok_ukuran")
}

model RiwayatStatus {
  id           String   @id @default(cuid())
  produkId     String
  produk       Produk   @relation(fields: [produkId], references: [id], onDelete: Cascade)
  divisi       Divisi
  statusDari   String?
  statusKe     String
  diubahOlehId String?
  diubahOleh   User?    @relation(fields: [diubahOlehId], references: [id])
  catatan      String?
  timestamp    DateTime @default(now())

  @@map("riwayat_status")
}
