# Connection string Postgres yang pooled (lewat PgBouncer, host "...-pooler..." di Neon) —
# dipakai aplikasi saat runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Connection string langsung (bukan lewat pooler) — dipakai CLI Prisma (migrate/studio).
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-secret-acak-anda"
